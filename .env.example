# Supabase → Project Settings → Database → Connection string.
# App runtime: transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Migrations and seed: session/direct connection (port 5432).
DATABASE_URL_DIRECT=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the deployment (optional on Vercel).
BETTER_AUTH_URL=http://localhost:3000

# Password for the demo staff accounts created by `pnpm db:seed`.
SEED_STAFF_PASSWORD=consigliere-demo

# Supabase → Project Settings → API. Public by design; only used for the live queue channel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Xendit → Settings → API keys (use a development key: xnd_development_…).
# Leave empty to use demo payments, which never touch a gateway.
XENDIT_SECRET_KEY=
# Xendit → Settings → Webhooks → verification token. Webhook URL: <origin>/api/pembayaran/xendit
XENDIT_WEBHOOK_TOKEN=

# Public demo. "1" shows the demo ribbon and one-tap logins (always on without DATABASE_URL).
DEMO_MODE=1
# Must match SEED_STAFF_PASSWORD, so the one-tap logins work.
DEMO_STAFF_PASSWORD=consigliere-demo
# Vercel Cron sends this as a bearer token to /api/demo/reset each night (00.00 WITA). openssl rand -hex 24
CRON_SECRET=

# WhatsApp Cloud API (Meta). Leave the first two empty to only log messages (Admin → Pesan).
# A system user's permanent token with whatsapp_business_messaging.
WHATSAPP_TOKEN=
# WhatsApp Manager → Phone numbers → the number → "Phone number ID" (not the phone number).
WHATSAPP_PHONE_NUMBER_ID=
# Optional overrides. Templates must be approved in this language.
# WHATSAPP_API_VERSION=v25.0
# WHATSAPP_TEMPLATE_OTP=kode_pin
# WHATSAPP_TEMPLATE_NEAR=antrean_dekat
# WHATSAPP_TEMPLATE_LANG=id
# Optional: only these numbers get real messages while testing (comma separated). Empty = everyone.
WHATSAPP_ALLOWLIST=

# Chatbot (Admin → Chat). The web chat on /tanya always works with the rule brain.
# Telegram: make a bot with @BotFather, paste its token, pick a random secret (16+ of A-Z a-z 0-9 _ -),
# then press "Sambungkan Telegram" in Admin → Chat. `openssl rand -hex 24` makes a good secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# "1" lets a language model answer through Vercel AI Gateway; it falls back to the rule brain on any error.
# On Vercel the gateway signs in with OIDC; elsewhere set AI_GATEWAY_API_KEY. Usage is billed by the gateway.
CHAT_AI=0
AI_GATEWAY_API_KEY=
# CHAT_MODEL=anthropic/claude-haiku-5.5
# Most AI answers per shop day across all chats; past it the rule brain answers.
# CHAT_AI_DAILY_CAP=300

# Sentry error tracking. Leave empty to keep it off; the SDK then never loads.
# The Sentry integration on Vercel sets all four. The DSN is public by design (it only accepts reports).
NEXT_PUBLIC_SENTRY_DSN=
# Optional, for readable stack traces: the build uploads source maps when the token is set.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
