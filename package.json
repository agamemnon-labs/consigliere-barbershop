{
  "name": "consigliere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:deploy": "sh -c 'if [ -n \"$DATABASE_URL_DIRECT\" ]; then drizzle-kit migrate || exit 1; node src/db/seed/run.ts --if-empty || exit 1; fi; next build'",
    "start": "next start",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env.local src/db/seed/run.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "11.16.0",
    "@supabase/supabase-js": "2.119.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "ai": "7.0.183",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@electric-sql/pglite": "0.5.17",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.21.0"
}
