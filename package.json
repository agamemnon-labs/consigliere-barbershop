{
  "name": "consigliere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env.local src/db/seed/run.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.21.0"
}
